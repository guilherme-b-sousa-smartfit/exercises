function preencherColunaB() {
  const ss = SpreadsheetApp.openById("121GJz4mJA2QvrG2iML0AwKuKW_Szgt2PqxYKn2Lg44s");
  const abas = ss.getSheets();
  const campos = ["image", "gif"];
  abas.slice(0, 2).forEach((aba, i) => {
    const nomes = aba.getRange(1, 1, aba.getLastRow(), 1).getValues();
    const saida = nomes.map(([nome]) => {
      const chave = String(nome).trim();
      const item = MEDIA[chave];
      return [item ? item[campos[i]] : ""];
    });
    aba.getRange(1, 2, saida.length, 1).setValues(saida);
  });
}
